{
  "name": "marca-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP de solo lectura con el sistema de diseño de la marca personal de Nehemias Pérez.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "marca-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validar": "tsx src/validar.ts",
    "start": "node dist/stdio.js",
    "dev": "tsx src/stdio.ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/stdio.ts",
    "evals": "tsx evals/ejecutar.ts",
    "sitio": "tsx sitio/generar.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
