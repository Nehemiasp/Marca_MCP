{
  "$description": "Sistema de diseño de la marca personal de Nehemias Pérez (Diseñador UI/UX). Formato W3C Design Tokens (DTCG).",
  "color": {
    "$type": "color",
    "$description": "Paleta de la marca. Tema claro; las variantes sobre fondo oscuro viven en color.oscuro.",
    "tinta": {
      "$value": "#0E1116",
      "$description": "Títulos, fondos oscuros y cuadros del motivo."
    },
    "texto": {
      "$value": "#2B2F36",
      "$description": "Texto de lectura."
    },
    "apagado": {
      "$value": "#6A707A",
      "$description": "Texto secundario y etiquetas."
    },
    "linea": {
      "$value": "#DADDE2",
      "$description": "Bordes y divisores."
    },
    "suave": {
      "$value": "#ECEDEF",
      "$description": "Fondos de etiquetas y cuadros claros del motivo."
    },
    "fondo": {
      "$value": "#FAFAF8",
      "$description": "Fondo de página."
    },
    "blanco": {
      "$value": "#FFFFFF",
      "$description": "Texto sobre tinta o azul, y cuadros blancos del motivo oscuro."
    },
    "azul": {
      "$value": "#043565",
      "$description": "Acento: palabra destacada, eyebrows y píldora del motivo. Nunca en bloques grandes."
    },
    "azul-suave": {
      "$value": "#E8EFF7",
      "$description": "Fondo del aviso destacado (junto a un borde izquierdo en color.azul). Valor propuesto: derivado del azul al 8%."
    },
    "oscuro": {
      "$description": "Colores para usar sobre fondo color.tinta.",
      "texto": {
        "$value": "{color.blanco}",
        "$description": "Texto principal sobre tinta."
      },
      "texto-apagado": {
        "$value": "#A3ABB6",
        "$description": "Texto secundario sobre tinta."
      },
      "linea": {
        "$value": "#2A303A",
        "$description": "Bordes sobre tinta."
      },
      "cuadro": {
        "$value": "#262C35",
        "$description": "Cuadros del motivo sobre tinta."
      },
      "acento": {
        "$value": "#8DB6E8",
        "$description": "Acento y píldora del motivo sobre tinta."
      }
    }
  },
  "tipografia": {
    "familia": {
      "$type": "fontFamily",
      "titulo": {
        "$value": [
          "Bricolage Grotesque",
          "Instrument Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Títulos, nombre y cifras grandes. Solo peso 800."
      },
      "texto": {
        "$value": [
          "Instrument Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Texto, interfaz y etiquetas."
      }
    },
    "peso": {
      "$type": "fontWeight",
      "extranegrita": {
        "$value": 800,
        "$description": "Bricolage Grotesque en títulos y cifras."
      },
      "normal": {
        "$value": 400,
        "$description": "Instrument Sans en texto corrido."
      },
      "medio": {
        "$value": 500,
        "$description": "Instrument Sans en interfaz."
      },
      "seminegrita": {
        "$value": 600,
        "$description": "Instrument Sans en botones y énfasis."
      },
      "negrita": {
        "$value": 700,
        "$description": "Instrument Sans en eyebrows y etiquetas."
      }
    },
    "tamano": {
      "$type": "dimension",
      "$description": "Escala tipográfica (propuesta). Se usa con tipografia.interlineado del mismo nombre.",
      "xs": {
        "$value": "12px",
        "$description": "Etiquetas, eyebrows, notas al pie."
      },
      "sm": {
        "$value": "14px",
        "$description": "Texto de interfaz, metadatos, tablas densas."
      },
      "base": {
        "$value": "16px",
        "$description": "Texto de lectura."
      },
      "lg": {
        "$value": "18px",
        "$description": "Texto destacado o introducción."
      },
      "xl": {
        "$value": "22px",
        "$description": "Subtítulos y títulos de tarjeta."
      },
      "2xl": {
        "$value": "28px",
        "$description": "Títulos de sección."
      },
      "3xl": {
        "$value": "36px",
        "$description": "Títulos de página."
      },
      "4xl": {
        "$value": "48px",
        "$description": "Título de portada o hero en pantallas medianas."
      },
      "5xl": {
        "$value": "64px",
        "$description": "Título display: hero y portada de documento."
      }
    },
    "interlineado": {
      "$type": "dimension",
      "$description": "Altura de línea que acompaña a cada tamaño de la escala.",
      "xs": {
        "$value": "16px",
        "$description": "Interlineado para tipografia.tamano.xs."
      },
      "sm": {
        "$value": "20px",
        "$description": "Interlineado para tipografia.tamano.sm."
      },
      "base": {
        "$value": "26px",
        "$description": "Interlineado para tipografia.tamano.base."
      },
      "lg": {
        "$value": "28px",
        "$description": "Interlineado para tipografia.tamano.lg."
      },
      "xl": {
        "$value": "30px",
        "$description": "Interlineado para tipografia.tamano.xl."
      },
      "2xl": {
        "$value": "34px",
        "$description": "Interlineado para tipografia.tamano.2xl."
      },
      "3xl": {
        "$value": "40px",
        "$description": "Interlineado para tipografia.tamano.3xl."
      },
      "4xl": {
        "$value": "52px",
        "$description": "Interlineado para tipografia.tamano.4xl."
      },
      "5xl": {
        "$value": "64px",
        "$description": "Interlineado para tipografia.tamano.5xl."
      }
    },
    "espaciado-letras": {
      "$type": "dimension",
      "titulo": {
        "$value": "-0.02em",
        "$description": "Ligeramente negativo en títulos de Bricolage Grotesque."
      },
      "eyebrow": {
        "$value": "0.12em",
        "$description": "Amplio, en mayúsculas, en eyebrows."
      },
      "normal": {
        "$value": "0em",
        "$description": "Texto de lectura."
      }
    }
  },
  "espaciado": {
    "$type": "dimension",
    "$description": "Escala de espaciado con base de 4px (propuesta). Nombres de talla para que en código se lea p-lg, gap-md.",
    "xs": {
      "$value": "4px",
      "$description": "4px. Separación mínima: icono y texto."
    },
    "sm": {
      "$value": "8px",
      "$description": "8px. Entre elementos muy cercanos."
    },
    "md": {
      "$value": "12px",
      "$description": "12px. Relleno de etiquetas y botones pequeños."
    },
    "base": {
      "$value": "16px",
      "$description": "16px. Espacio estándar entre elementos."
    },
    "lg": {
      "$value": "24px",
      "$description": "24px. Relleno de tarjetas; separación entre bloques de texto."
    },
    "xl": {
      "$value": "32px",
      "$description": "32px. Separación entre grupos."
    },
    "2xl": {
      "$value": "48px",
      "$description": "48px. Separación entre secciones pequeñas."
    },
    "3xl": {
      "$value": "64px",
      "$description": "64px. Separación entre secciones."
    },
    "4xl": {
      "$value": "96px",
      "$description": "96px. Margen de portada y secciones de página completa."
    }
  },
  "radio": {
    "$type": "dimension",
    "$description": "Radios de borde (propuestos).",
    "sm": {
      "$value": "6px",
      "$description": "Etiquetas pequeñas y campos."
    },
    "md": {
      "$value": "10px",
      "$description": "Botones y avisos."
    },
    "lg": {
      "$value": "16px",
      "$description": "Tarjetas y contenedores."
    },
    "cuadro": {
      "$value": "14px",
      "$description": "Cuadros de la rejilla del motivo de marca."
    },
    "pill": {
      "$value": "999px",
      "$description": "Píldoras, etiquetas y la píldora del motivo."
    }
  },
  "sombra": {
    "$type": "shadow",
    "$description": "Sombras (propuestas). Por defecto la marca no usa sombras; estas son la excepción.",
    "suave": {
      "$value": {
        "color": "#0E11160F",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "Elevación mínima: tarjetas en reposo."
    },
    "elevada": {
      "$value": {
        "color": "#0E11161A",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "Elementos flotantes: menús y diálogos."
    }
  },
  "$extensions": {
    "marca": {
      "version": "1.0.0",
      "pares": [
        {
          "texto": "color.tinta",
          "fondo": "color.fondo",
          "nivel": "AAA",
          "uso": "Títulos sobre página."
        },
        {
          "texto": "color.texto",
          "fondo": "color.fondo",
          "nivel": "AAA",
          "uso": "Texto de lectura."
        },
        {
          "texto": "color.apagado",
          "fondo": "color.fondo",
          "nivel": "AA",
          "uso": "Texto secundario sobre página."
        },
        {
          "texto": "color.azul",
          "fondo": "color.fondo",
          "nivel": "AAA",
          "uso": "Palabra destacada y eyebrows."
        },
        {
          "texto": "color.tinta",
          "fondo": "color.suave",
          "nivel": "AAA",
          "uso": "Texto dentro de etiquetas."
        },
        {
          "texto": "color.texto",
          "fondo": "color.azul-suave",
          "nivel": "AAA",
          "uso": "Texto dentro del aviso destacado."
        },
        {
          "texto": "color.azul",
          "fondo": "color.azul-suave",
          "nivel": "AAA",
          "uso": "Eyebrow o enlace dentro del aviso."
        },
        {
          "texto": "color.blanco",
          "fondo": "color.tinta",
          "nivel": "AAA",
          "uso": "Encabezado de tabla y botón principal."
        },
        {
          "texto": "color.blanco",
          "fondo": "color.azul",
          "nivel": "AAA",
          "uso": "Texto sobre bloques o botones azules."
        },
        {
          "texto": "color.oscuro.texto",
          "fondo": "color.tinta",
          "nivel": "AAA",
          "uso": "Texto principal sobre tinta."
        },
        {
          "texto": "color.oscuro.texto-apagado",
          "fondo": "color.tinta",
          "nivel": "AA",
          "uso": "Texto secundario sobre tinta."
        },
        {
          "texto": "color.oscuro.acento",
          "fondo": "color.tinta",
          "nivel": "AA",
          "uso": "Acento sobre tinta."
        }
      ],
      "paresProhibidos": [
        {
          "texto": "color.apagado",
          "fondo": "color.suave",
          "motivo": "Contraste bajo para texto pequeño; use color.texto o color.tinta dentro de etiquetas."
        },
        {
          "texto": "color.azul",
          "fondo": "color.tinta",
          "motivo": "Sobre tinta use color.oscuro.acento."
        }
      ]
    }
  }
}
